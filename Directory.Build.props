<Project>
  <PropertyGroup>
    <!-- A normal Rider Build Project uses Debug. Keep the distributable DLL in
         the release folder so there is only one artifact to install. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath Condition="'$(Configuration)' == 'Debug'">bin\Release\</OutputPath>

    <!-- The mod is loaded directly by Unity; keep the release artifact small
         and ensure the compiler performs its normal runtime optimizations. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
